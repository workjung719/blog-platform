# Database Configuration
DB_HOST=localhost
DB_PORT=5436
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blog_db
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars-long-ok
JWT_EXPIRATION_HOURS=24

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Scheduler
SCHEDULER_INTERVAL_SEC=5
SCHEDULER_WORKERS=3

LOG_LEVEL=info
ENV=development