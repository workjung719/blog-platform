# PostgreSQL (порт 5436, чтобы не конфликтовать с локальной БД)
DB_HOST=localhost
DB_PORT=5436
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blog_platform
DB_SSLMODE=disable

# JWT — минимум 32 символа, генерируйте случайный!
JWT_SECRET=replace-with-a-random-secure-string-at-least-32-chars-long-ok
JWT_EXPIRATION_HOURS=24

SERVER_PORT=8080

# Планировщик отложенных публикаций
SCHEDULER_INTERVAL_SEC=5
SCHEDULER_WORKERS=3

LOG_LEVEL=info